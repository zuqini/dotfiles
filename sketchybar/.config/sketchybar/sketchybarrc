# This is a demo config to showcase some of the most important commands.
# It is meant to be changed and configured, as it is intentionally kept sparse.
# For a (much) more advanced configuration example see my dotfiles:
# https://github.com/FelixKratz/dotfiles

PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Bar Appearance #####
# Configuring the general appearance of the bar.
# These are only some of the options available. For all options see:
# https://felixkratz.github.io/SketchyBar/config/bar
# If you are looking for other colors, see the color picker:
# https://felixkratz.github.io/SketchyBar/config/tricks#color-picker

sketchybar --bar \
    position=top \
    height=32 \
    color=0x00000000 \
    margin=-10 \
    y_offset=4

##### Changing Defaults #####
# We now change some default values, which are applied to all further items.
# For a full list of all available item properties see:
# https://felixkratz.github.io/SketchyBar/config/items

default=(
    icon.font="Iosevka Nerd Font:Regular:18.0"
    label.font="Iosevka Nerd Font:Regular:13.0"
    icon.color=0xffcbd9d8
    label.color=0xffe6eaea
    icon.padding_left=18
    icon.padding_right=4
    label.padding_left=4
    label.padding_right=18
    background.height=32
    background.color=0x44000000
    background.drawing=off
)
sketchybar --default "${default[@]}"

##### Menu Items #####
sketchybar --add item apple.logo left \
    --set apple.logo icon= \
        padding_right=4 \
        icon.padding_right=18 \
        icon.padding_left=18 \
        label.drawing=off \
        script="$PLUGIN_DIR/hover.sh" \
        click_script="open -a 'System Preferences'" \
        background.corner_radius=9 \
    --subscribe apple.logo mouse.entered mouse.exited

##### Aerospace Integration #####
sketchybar --add event aerospace_workspace_change

for sid in $(aerospace list-workspaces --all); do
    sketchybar --add item space.$sid left \
        --subscribe space.$sid aerospace_workspace_change \
        --set space.$sid \
        label="$sid" \
        label.padding_left=9 \
        label.padding_right=9 \
        label.color=0xff587b7b \
        icon.drawing=off \
        click_script="aerospace workspace $sid" \
        script="$PLUGIN_DIR/aerospace.sh $sid"
done

# sketchybar --set space.1 label.padding_left=18 \
#     --set space.10 label.padding_right=18

sketchybar --add item front_app left \
        --set front_app icon.drawing=off script="$PLUGIN_DIR/front_app.sh" \
        label.padding_left=18 \
        label.padding_right=18 \
        --subscribe front_app front_app_switched \
    --add item service q \
        --set service icon=  \
        icon.padding_left=18 \
        icon.padding_right=18 \
        label.drawing=off \
        background.color=0xcc152528 \
        background.corner_radius=9 \
        blur_radius=5 \
        background.border_color=0xcc254147 \
        background.border_width=1 \
        drawing=off \
    --add item clock right \
        --set clock update_freq=30 \
        script="$PLUGIN_DIR/clock.sh" \
        icon.drawing=off \
        label.font.style=SemiBold \
        label.padding_left=4 \
        label.color=0xff0f1c1e \
    --add item calendar right \
        --set calendar update_freq=30 \
        script="$PLUGIN_DIR/calendar.sh" \
        icon.drawing=off \
        label.padding_right=4 \
        label.padding_left=9 \
        label.font.style=Heavy \
        label.color=0xff0f1c1e \
    --add item battery right \
        --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh" \
        label.font.style=SemiBold \
        label.padding_right=9 \
        label.color=0xff0f1c1e \
        icon.color=0xff0f1c1e \
        --subscribe battery system_woke power_source_change \
    --add item wifi right \
        --set wifi icon=󰖩 scroll_texts=on label.max_chars=6 \
        background.corner_radius=9 \
        script="$PLUGIN_DIR/hover.sh && $PLUGIN_DIR/wifi.sh" \
        click_script="open /System/Library/PreferencePanes/Network.prefPane" \
        --subscribe wifi wifi_change mouse.entered mouse.exited \
    --add item volume right \
        --set volume script="$PLUGIN_DIR/hover.sh && $PLUGIN_DIR/volume.sh" \
        background.corner_radius=9 \
        click_script="$PLUGIN_DIR/mute_toggle.sh" \
        --subscribe volume volume_change mouse.entered mouse.exited \
    --add item bluetooth right \
        --set bluetooth icon=󰂯  label.drawing=off \
        background.corner_radius=9 \
        icon.padding_right=18 \
        script="$PLUGIN_DIR/hover.sh" \
        click_script="open /System/Library/PreferencePanes/Bluetooth.prefPane" \
        --subscribe bluetooth mouse.entered mouse.exited \
    --add item mail right \
        --set mail update_freq=10 icon=  label.color=0xfffda47f \
        background.corner_radius=9 \
        script="$PLUGIN_DIR/hover.sh && $PLUGIN_DIR/status_label.sh Mail" \
        click_script="open -a mail" \
        --subscribe mail mouse.entered mouse.exited \
    --add item slack right \
        --set slack update_freq=10 icon=󰒱  label.color=0xfffda47f \
        background.corner_radius=9 \
        script="$PLUGIN_DIR/hover.sh && $PLUGIN_DIR/status_label.sh Slack" \
        click_script="open -a slack" \
        --subscribe slack mouse.entered mouse.exited

sketchybar \
    --add bracket left_items apple.logo '/space\..*/' front_app \
        --set left_items background.color=0xcc152528 \
        background.corner_radius=9 \
        blur_radius=5 \
        background.border_color=0xcc254147 \
        background.border_width=1 \
    --add bracket right_items calendar clock battery volume wifi bluetooth mail slack \
        --set right_items background.color=0xcc152528 \
        background.corner_radius=9 \
        blur_radius=5 \
        background.border_color=0xcc254147 \
        background.border_width=1 \
    --add bracket spaces '/space\..*/' \
        --set spaces background.color=0x88264048 \
        background.corner_radius=8 \
        background.height=22 \
        background.border_color=0x442d4f56 \
        background.border_width=1 \
    --add bracket right_static_info calendar clock battery \
        --set right_static_info background.color=0xff5a93aa \
        background.corner_radius=9 \
        background.height=32 \
        background.border_color=0xff1d3337 \
        background.border_width=3

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update
